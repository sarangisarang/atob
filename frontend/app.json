{
  "expo": {
    "name": "ATOB Transporter",
    "slug": "atob-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1a73e8"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a73e8"
      },
      "package": "com.atob.transporter",
      "usesCleartextTraffic": true
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow ATOB to use your location for shipment tracking."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ATOB to access your photos to upload product images.",
          "cameraPermission": "Allow ATOB to use your camera to take product photos."
        }
      ]
    ]
  }
}
