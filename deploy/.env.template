# ═══════════════════════════════════════════════════════════════
# ATOB Transport — Production Environment Variables
# ═══════════════════════════════════════════════════════════════
#
# USAGE:
#   cp .env.template .env
#   nano .env        ← fill in real values
#   chmod 600 .env   ← restrict access
#
# STRICT RULE: .env must NEVER be committed to Git.
# ═══════════════════════════════════════════════════════════════

# ─── Database ────────────────────────────────────────────────────────────────
DB_NAME=atobapp
DB_USER=atob_user
DB_PASSWORD=CHANGE_ME_strong_random_password_min_32_chars

# ─── Domain ──────────────────────────────────────────────────────────────────
# Replace with your actual domain (e.g. api.atob-transport.com)
API_DOMAIN=api.YOUR-DOMAIN.com

# ─── Spring Boot ─────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://YOUR-DOMAIN.com

# ─── Future JWT (not yet used — keep for Phase 2) ────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_64
